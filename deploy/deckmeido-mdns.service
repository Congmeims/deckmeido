[Unit]
Description=DeckMeido mDNS (deckmeido.local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/deploy/mdns_publish.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
