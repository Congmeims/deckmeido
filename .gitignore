# 密钥与本地配置
server/config.toml
# 长期记忆与人设（教学/调校出来的内容属于用户数据）
server/memory.json
server/meidosoul.json

# Python
__pycache__/
*.py[cod]
.venv/

# 日志与临时文件
*.log
nohup.out

# 系统
.DS_Store
Thumbs.db

# 会话记录与运行产物
server/sessions/
server/static/shots/
server/uploads/
_sess.json

# 发布打包产物
dist/

# 离线依赖包（体积大，不进仓库；发版时由 tools/fetch_offline_deps.sh 现拉）
deploy/deps/*.pkg.tar.zst

# 安装时生成的产物（由 install.sh 写入，不入库）
VERSION
uninstall.sh

# 上传的图片（运行时产物）
server/static/uploads/

# 多 agent 协作通道（本地信箱，不入库；见 _comms/README.md）
_comms/

# 编辑过程中的临时备份（*.bak-*、*.bak-时间戳、_backup_*/）
*.bak-*
*.bak
_backup_*/
server/*.bak*
server/static/*.bak*
server/backup*.log*
server/backend.log*
server/static/_logo_prev.png
